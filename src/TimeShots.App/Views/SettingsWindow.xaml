<Window x:Class="TimeShots.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeShots — Settings"
        Width="500" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#1e293b" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0284c7" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hotkeys -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Global shortcuts to trigger captures." FontSize="12" Foreground="#94a3b8" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Capture Fullscreen:" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHotkeyFullscreen" Width="140" HorizontalAlignment="Right" Text="Ctrl+Shift+S" IsReadOnly="True" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Capture Window:" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHotkeyWindow" Width="140" HorizontalAlignment="Right" Text="Ctrl+Shift+W" IsReadOnly="True" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Capture Region:" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHotkeyRegion" Width="140" HorizontalAlignment="Right" Text="Ctrl+Shift+R" IsReadOnly="True" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Open Gallery:" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtHotkeyGallery" Width="140" HorizontalAlignment="Right" Text="Ctrl+Shift+G" IsReadOnly="True" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Storage" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Destination folder for PNG captures and metadata sidecars." FontSize="12" Foreground="#94a3b8" Margin="0,0,0,8" />
                        <DockPanel LastChildFill="True">
                            <Button Content="Browse" DockPanel.Dock="Right" Width="70" Margin="8,0,0,0" Click="OnBrowseStorageClick" />
                            <TextBox x:Name="TxtStoragePath" Text="~/.timeshots/captures" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Time Sync -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Time Synchronization" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="NTP server used for authoritative UTC time." FontSize="12" Foreground="#94a3b8" Margin="0,0,0,8" />
                        <TextBox x:Name="TxtNtpServer" Text="pool.ntp.org" />
                    </StackPanel>
                </Border>

                <!-- Overlay Appearance -->
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Overlay Style" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Timestamp overlay format on screenshot." FontSize="12" Foreground="#94a3b8" Margin="0,0,0,8" />
                        <ComboBox x:Name="CmbOverlayStyle" SelectedIndex="0">
                            <ComboBoxItem Content="Default (UTC + Local + Hash + Seq)" />
                            <ComboBoxItem Content="Compact (Local time only)" />
                            <ComboBoxItem Content="Minimal (Single line)" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtStatus" Text="Settings saved." Foreground="#22c55e" FontWeight="SemiBold"
                       VerticalAlignment="Center" Visibility="Collapsed" DockPanel.Dock="Left" />
            <Button Style="{StaticResource ActionButton}" Content="Save Changes" DockPanel.Dock="Right" Click="OnSaveClick" />
        </DockPanel>
    </Grid>
</Window>
